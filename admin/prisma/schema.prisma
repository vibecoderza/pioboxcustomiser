generator client {
  provider = "prisma-client-js"
}

// Sessions must survive between serverless invocations, so this is Postgres (Neon via the
// Vercel marketplace), not the template's SQLite file. The schema is applied with
// `prisma db push` during the Vercel build; no migration files yet.
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Session {
  id                  String    @id
  shop                String
  state               String
  isOnline            Boolean   @default(false)
  scope               String?
  expires             DateTime?
  accessToken         String
  userId              BigInt?
  firstName           String?
  lastName            String?
  email               String?
  accountOwner        Boolean   @default(false)
  locale              String?
  collaborator        Boolean?  @default(false)
  emailVerified       Boolean?  @default(false)
  refreshToken        String?
  refreshTokenExpires DateTime?
}
