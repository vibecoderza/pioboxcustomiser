{% comment %}
  Piobox design studio. Render on the product template:
    {% render 'piobox-customizer-live', product: product %}

  Generic on purpose: there is no product and no host in this file. A product opts in by
  having the `piobox.customizer` metafield; everything else comes from
  `shop.metafields.piobox.settings`. Adding a blank is an admin job, not a theme edit.

  The studio is hosted on Vercel, not in this theme's assets — deploying it is `npm run deploy`
  in the Piobox repo, with nothing to re-upload here.
{% endcomment %}

{%- assign pc = product.metafields.piobox.customizer.value -%}
{%- assign pcfg = shop.metafields.piobox.settings.value -%}

{%- if pc and pc.enabled and pcfg -%}
  {%- assign host = pcfg.studioHost -%}
  {%- assign decoration = all_products[pcfg.decorationHandle] -%}
  {%- assign setup = all_products[pcfg.setupHandle] -%}

<link rel="stylesheet" href="{{ host }}/piobox-customizer/customizer.css">
<button type="button" class="button button--primary" data-piobox-open>{{ pc.buttonLabel | default: 'Design yours' }}</button>
<div id="piobox-studio-{{ product.id }}" data-piobox-host></div>

<script type="application/json" data-piobox-product>{{ product | json }}</script>
<script type="application/json" data-piobox-config>{{ pc | json }}</script>
<script type="application/json" data-piobox-settings>{{ pcfg | json }}</script>

{%- comment -%}
  The decoration ladder is built from the live Decoration product rather than copied in here, so
  it cannot drift from what the cart can actually bill. Setup fees likewise, matched by SKU.
{%- endcomment -%}
<script type="application/json" data-piobox-ladder>
{
  "step": {{ pcfg.pricing.roundUnitTo | default: 100 }},
  "variants": {
    {%- for v in decoration.variants -%}
      {%- unless forloop.first %},{% endunless -%}
      "{{ v.price }}": {{ v.id }}
    {%- endfor -%}
  }
}
</script>
<script type="application/json" data-piobox-setup>
{
  {%- for v in setup.variants -%}
    {%- unless forloop.first %},{% endunless -%}
    "{{ v.sku }}": {{ v.id }}
  {%- endfor -%}
}
</script>

<script type="module">
  const read = (sel) => { try { return JSON.parse(document.querySelector(sel).textContent); } catch { return null; } };
  const shopifyProduct = read("[data-piobox-product]");
  const config     = read("[data-piobox-config]")   || {};
  const settings   = read("[data-piobox-settings]") || {};
  const ladder     = read("[data-piobox-ladder]");
  const setupBySku = read("[data-piobox-setup]") || {};

  const HOST = settings.studioHost;
  const [{ mount }, { productFromShopify, createShopifyCart }, { createVercelBlobUploader }] = await Promise.all([
    import(`${HOST}/piobox-customizer/customizer.js`),
    import(`${HOST}/piobox-customizer/shopify-adapter.js`),
    import(`${HOST}/piobox-customizer/uploader.js`),
  ]);

  // The theme keys setup variants by SKU (stable across re-imports); the adapter wants them
  // keyed by decoration method.
  const setupVariants = {};
  for (const [method, sku] of Object.entries(settings.setupSkus || {})) {
    if (setupBySku[sku]) setupVariants[method] = setupBySku[sku];
  }

  const product = productFromShopify(shopifyProduct, config);
  const studio = mount(document.querySelector("[data-piobox-host]"), {
    products: [product],
    photoBase: "",
    // Garment bounding boxes per photo, set in the admin's Blanks screen. Without these the
    // studio falls back to generic category zones, which sit noticeably off the real garment.
    photoFrames: config.photoFrames || {},
    fontBase: `${HOST}/assets/fonts`,
    modal: true,
    mode: "cart",
    defaultQuantity: 1,
    defaultMethod: settings.defaultMethod || "dtg",
    persistDraft: false,
    // Default to stocked-only: an unstocked Pantone must not be orderable at the stocked price.
    stockedColorsOnly: settings.stockedColorsOnly !== false,
    // pricing.roundUnitTo must match the ladder's step. Both are read from the same settings
    // metafield and the ladder itself is built from the Decoration product, so they agree.
    pricing: settings.pricing,
    labels: { addToCart: "Add to cart" },
    onSubmit: createShopifyCart({
      strategy: "line-items",
      root: "",
      ladder,
      setupVariants,
      uploadFiles: createVercelBlobUploader({ handleUploadUrl: `${HOST}/api/upload` }),
      onAdded: () => {
        studio.close();
        document.dispatchEvent(new CustomEvent("cart:refresh", { bubbles: true }));
        document.dispatchEvent(new CustomEvent("cart:build"));
        window.location.href = "/cart";
      },
    }),
  });

  document.querySelectorAll("[data-piobox-open]").forEach((b) => b.addEventListener("click", () => studio.open()));
  if (new URLSearchParams(location.search).has("customise")) studio.open();
</script>
{%- endif -%}
