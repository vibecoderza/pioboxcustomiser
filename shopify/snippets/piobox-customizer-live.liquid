<script type="module">
  import { mount } from "https://studio.blankd.co.za/piobox-customizer/customizer.js";
  import { productFromShopify, createShopifyCart } from "https://studio.blankd.co.za/piobox-customizer/shopify-adapter.js";
  import { createVercelBlobUploader } from "https://studio.blankd.co.za/piobox-customizer/uploader.js";

  const read = (sel) => { try { return JSON.parse(document.querySelector(sel).textContent); } catch { return null; } };
  const shopifyProduct = read("[data-piobox-product]");
  const config = read("[data-piobox-config]") || {};
  const ladder = read("[data-piobox-ladder]");
  const product = productFromShopify(shopifyProduct, config);

  const studio = mount(document.querySelector("[data-piobox-host]"), {
    products: [product],
    photoBase: "",
    fontBase: "https://studio.blankd.co.za/assets/fonts",
    modal: true,
    mode: "cart",
    defaultQuantity: 1,
    defaultMethod: "dtg",
    persistDraft: false,
    // roundUnitTo must match the Decoration ladder's step (R1.00 = 100c) so every charge lands
    // on a rung the cart can actually bill — that is what keeps the cart equal to the quote.
    // Rounding is to the NEAREST rand, so a unit price can settle up to 50c either side of the
    // exact cost+40%. Drop this to 50 only after the 50c ladder exists in Shopify.
    pricing: { currency: "ZAR", locale: "en-ZA", roundUnitTo: 100, blankSellPrices: true, minimumQty: 1 },
    labels: { addToCart: "Add to cart" },
    onSubmit: createShopifyCart({
      strategy: "line-items",
      root: "",
      ladder,
      setupVariants: { screen: 50370254143728, embroidery: 50370254176496 },
      uploadFiles: createVercelBlobUploader({
        handleUploadUrl: "https://studio.blankd.co.za/api/upload",
      }),
      onAdded: () => {
        studio.close();
        document.dispatchEvent(new CustomEvent("cart:refresh", { bubbles: true }));
        document.dispatchEvent(new CustomEvent("cart:build"));
        window.location.href = "/cart";
      },
    }),
  });

  document.querySelectorAll("[data-piobox-open]").forEach((b) => b.addEventListener("click", () => studio.open()));
  if (new URLSearchParams(location.search).has("customise")) studio.open();
</script>
{% endif %}
