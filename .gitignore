# Secrets — never commit. .env.local holds a Vercel OIDC token; .vercel/ holds pulled
# production env values.
.env
.env.*
!.env.example
.vercel/

# Dependencies and build output (regenerated by `npm install` / `npm run build`).
# /public is the studio's build output; admin/public is the app's real static assets, so
# the pattern is anchored to the root.
node_modules/
/public/
*.map
admin/build/
admin/.cache/
admin/.shopify/
admin/prisma/*.sqlite*

# Customer design drafts written by the local dev server
designs/

# OS noise
.DS_Store
Thumbs.db
